# Artefactos de trabalho do pipeline 3D — nunca versionar binários.
# (Fontes, scripts e documentos SIM são versionados.)
assets/raw/
assets/extracted/
assets/work/
assets/glb_staging/
*.blend
*.blend1
*.glb
*.gltf
*.fbx
*.obj
*.xbm
*.mesh
*.rig
*.anims
*.ent
*.app
*.archive
*.re
*.mlsetup
*.mlmask
*.effect
*.particle
!docs/**/*.png

# Bytecode Python — nunca versionar.
__pycache__/
*.pyc

# Dumps serializados grandes de dados do jogo (regeneráveis com
# `wolvenkit-cli convert serialize`); ficam só os resumos pequenos
# (nue_bones.txt, nue_rig.json, provenance.txt).
assets/_inventory/rig_json/

# Material de trabalho/entregável da animação (clips .mp4, stills .png
# grandes, .gif) — fica na worktree, nunca versionado. Colocado DEPOIS de
# `!docs/**/*.png` para garantir que a regra vence a re-inclusão.
docs/renders/anim/

# Renders de trabalho do modelo CS2 (stills + frames de animação) — worktree.
docs/renders/cs2/

# Dumps serializados de animacoes (mesma politica dos rig_json).
assets/_inventory/anims_json/

# Starters .re + Metadata do plugin REDmod (material CDPR, extrair do zip oficial).
assets/_inventory/redmod_starters/

# Logs de debug.
assets/_inventory/*_log.txt

